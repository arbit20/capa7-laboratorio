{
  "name": "capa7-laboratorio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "demo": "node scripts/serve.mjs",
    "test": "vitest run src --reporter=default --reporter=json --outputFile=evidence/unit-results.json",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run build && npm run test:e2e && npm run qa:report",
    "qa:report": "node scripts/report.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.json *.ts index.html"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
